# Never commit a real .env file. Use a dedicated mint wallet with only the
# mint value, gas, and a small safety margin.
# After copying this file, run: chmod 600 .env
PRIVATE_KEY=

# The bot connects to all configured endpoints during startup.
WS_RPC_URL=wss://your-websocket-rpc.example
HTTP_RPC_URL=https://your-http-rpc.example
BACKUP_RPC_URL=
# Comma-separated additional HTTP broadcast endpoints. Optional.
BROADCAST_RPC_URLS=

# Optional chain-specific RPC profiles used by the interactive launcher.
# If a profile is configured, it is selected automatically when that network
# is chosen. Keep backup/broadcast URLs on the same chain as the profile.
ROBINHOOD_WS_RPC_URL=
ROBINHOOD_HTTP_RPC_URL=
ROBINHOOD_BACKUP_RPC_URL=
ROBINHOOD_BROADCAST_RPC_URLS=
INK_WS_RPC_URL=wss://ws-gel.inkonchain.com
INK_HTTP_RPC_URL=https://rpc-gel.inkonchain.com
INK_BACKUP_RPC_URL=
INK_BROADCAST_RPC_URLS=
HYPEREVM_WS_RPC_URL=
HYPEREVM_HTTP_RPC_URL=https://rpc.hyperliquid.xyz/evm
HYPEREVM_BACKUP_RPC_URL=
HYPEREVM_BROADCAST_RPC_URLS=
ABSTRACT_WS_RPC_URL=wss://api.mainnet.abs.xyz/ws
ABSTRACT_HTTP_RPC_URL=https://api.mainnet.abs.xyz
ABSTRACT_BACKUP_RPC_URL=
ABSTRACT_BROADCAST_RPC_URLS=

# Required for OpenSea Drops API mode or post-mint auto-sell. Keep this secret
# and never commit .env.
OPENSEA_API_KEY=

# Per-request safety timeouts in milliseconds. Optional.
RPC_TIMEOUT_MS=5000
BROADCAST_TIMEOUT_MS=3000

# Optional logging filter, for example: nft_mint_bot=info
RUST_LOG=nft_mint_bot=info

# USD conversion used by auto-buy and post-mint auto-sell. ETH/USD and HYPE/USD
# are fetched from CoinMarketCap when their overrides are omitted. WETH uses the
# same ETH price. USDG and other native gas currencies require an
# explicit, current price; they never silently default to a peg. Symbols use
# the pattern <SYMBOL>_USD_PRICE, for example POL_USD_PRICE or AVAX_USD_PRICE.
ETH_USD_PRICE=
USDG_USD_PRICE=
# Optional fixed override; leave blank for live HYPE/USD prices.
HYPE_USD_PRICE=
# Optional separate HYPE oracle (CoinMarketCap quote or {"hyperliquid":{"usd":...}}).
# HYPE_PRICE_ORACLE_URL=https://pro-api.coinmarketcap.com/v3/cryptocurrency/quotes/latest?id=32196&convert=USD
# POL_USD_PRICE=
# AVAX_USD_PRICE=
# BNB_USD_PRICE=
# CoinMarketCap API key. It is sent as X-CMC_PRO_API_KEY only to CoinMarketCap
# URLs. Keep this secret and never commit .env.
COINMARKETCAP_API_KEY=
# Optional CoinGecko Demo/Pro key if PRICE_ORACLE_URL is changed to CoinGecko.
COINGECKO_API_KEY=
PRICE_ORACLE_URL=https://pro-api.coinmarketcap.com/v3/cryptocurrency/quotes/latest?id=1027&convert=USD
